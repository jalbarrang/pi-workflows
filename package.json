{
  "name": "@dreki-gg/pi-workflows",
  "version": "0.1.0",
  "description": "Secure multi-agent workflow orchestration for pi",
  "keywords": [
    "agents",
    "pi-package",
    "workflows"
  ],
  "license": "MIT",
  "author": "Juan Albarran <jalbarrandev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jalbarrang/pi-workflows.git"
  },
  "files": [
    "extensions",
    "!extensions/workflows/__tests__/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json",
    "CONTEXT.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings extensions scripts && eslint . --max-warnings=0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --experimental-strip-types --test extensions/workflows/__tests__/*.test.ts",
    "line-count": "node scripts/check-lines.mjs"
  },
  "dependencies": {
    "@dreki-gg/pi-command-sandbox": "^0.4.2",
    "acorn": "^8.17.0",
    "effect": "4.0.0-beta.101"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "@types/node": "26",
    "@typescript-eslint/parser": "^8.46.2",
    "bun-types": "latest",
    "eslint": "^10.7.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typebox": "1.3.6",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.15.1",
  "pi": {
    "extensions": [
      "./extensions/workflows"
    ]
  }
}
